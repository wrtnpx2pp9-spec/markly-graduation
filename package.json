{
  "name": "markly-graduation",
  "version": "1.0.0-education.1",
  "description": "Markly 毕业设计学习版：Node.js + SQLite 学习监督、滚动计划与双向反馈系统。",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings server.js",
    "dev": "node --no-warnings server.js",
    "reset": "node --env-file-if-exists=.env scripts/reset.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.js",
    "setup:env": "node scripts/setup-env.js",
    "check:upgrade": "node --env-file-if-exists=.env scripts/check-upgrade.cjs",
    "test:ops": "node --no-warnings scripts/ops-smoke.cjs",
    "release:check": "node scripts/release-check.cjs",
    "test": "node --test --test-force-exit",
    "test:ui": "node scripts/ui-check.cjs",
    "demo:seed": "node --no-warnings scripts/demo-seed.cjs",
    "demo": "node --no-warnings scripts/demo-server.cjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "supervision",
    "check-in",
    "habit",
    "study",
    "reminder",
    "life-log"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/wrtnpx2pp9-spec/markly-graduation.git"
  }
}
