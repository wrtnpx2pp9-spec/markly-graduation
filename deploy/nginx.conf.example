# Replace markly.example.com and certificate paths before nginx -t.
server {
    listen 80;
    server_name markly.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name markly.example.com;
    ssl_certificate /etc/letsencrypt/live/markly.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/markly.example.com/privkey.pem;
    client_max_body_size 8m;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # This is the only public-facing proxy: discard client-supplied chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
