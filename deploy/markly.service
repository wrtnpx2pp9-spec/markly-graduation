[Unit]
Description=Markly supervision application
After=network.target

[Service]
Type=simple
User=markly
Group=markly
WorkingDirectory=/opt/markly
EnvironmentFile=/opt/markly/.env
ExecStart=/usr/bin/node --no-warnings /opt/markly/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/markly/data

[Install]
WantedBy=multi-user.target
