# npm run setup:env generates independent random secrets without printing them.
# npm start loads .env; existing service environment variables take precedence.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
# All calendar boundaries and reminders must use one stable business timezone.
TZ=Asia/Shanghai
# Set to 1 and restart before recovery; blocks requests and all background work.
MAINTENANCE_MODE=0
SETUP_TOKEN=
PLAN_AGENT_MASTER_KEY=
ADMIN_AGENT_SECONDARY_PASSWORD=
# Use an absolute path if overriding. Include iLink state in protected backups.
# DB_PATH=/opt/markly/data/app.db
# ILINK_STATE_DIR=/opt/markly/data/ilink-state
# BACKUP_DIR=/opt/markly/data/backups
# Only the actual reverse proxy addresses; leave empty for direct local access.
TRUSTED_PROXY_IPS=
NOTIFY_CONCURRENCY=8
SCHEDULER_BATCH_SIZE=100
